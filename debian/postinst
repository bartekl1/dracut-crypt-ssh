#!/bin/sh
# postinst script for dracut-crypt-ssh.
#
# See: dh_installdeb(1).

set -e

# Summary of how this script can be called:
#        * <postinst> 'configure' <most-recently-configured-version>
#        * <old-postinst> 'abort-upgrade' <new version>
#        * <conflictor's-postinst> 'abort-remove' 'in-favour' <package>
#          <new-version>
#        * <postinst> 'abort-remove'
#        * <deconfigured's-postinst> 'abort-deconfigure' 'in-favour'
#          <failed-install-package> <version> 'removing'
#          <conflicting-package> <version>
# for details, see https://www.debian.org/doc/debian-policy/ or
# the debian-policy package.

CONFIG_DIRECTORY="/etc/dracut-crypt-ssh"

case "$1" in
    configure)
        if [ ! -d $CONFIG_DIRECTORY ]; then
            mkdir $CONFIG_DIRECTORY
            chmod 600 $CONFIG_DIRECTORY
        fi
        if [ ! -f "$CONFIG_DIRECTORY/rsa_key" ]; then
            ssh-keygen -t rsa -f "$CONFIG_DIRECTORY/rsa_key" -q -N ""
            chmod 600 "$CONFIG_DIRECTORY/rsa_key"
            chmod 600 "$CONFIG_DIRECTORY/rsa_key.pub"
        fi
        if [ ! -f "$CONFIG_DIRECTORY/ecdsa_key" ]; then
            ssh-keygen -t ecdsa -f "$CONFIG_DIRECTORY/ecdsa_key" -q -N ""
            chmod 600 "$CONFIG_DIRECTORY/ecdsa_key"
            chmod 600 "$CONFIG_DIRECTORY/ecdsa_key.pub"
        fi
        if [ ! -f "$CONFIG_DIRECTORY/ed25519_key" ]; then
            ssh-keygen -t ed25519 -f "$CONFIG_DIRECTORY/ed25519_key" -q -N ""
            chmod 600 "$CONFIG_DIRECTORY/ed25519_key"
            chmod 600 "$CONFIG_DIRECTORY/ed25519_key.pub"
        fi
        if [ ! -f "$CONFIG_DIRECTORY/authorized_keys" ]; then
            touch "$CONFIG_DIRECTORY/authorized_keys"
            chmod 600 "$CONFIG_DIRECTORY/authorized_keys"
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
